# Production configuration for the InnoTech'26 API. deploy/ writes these into /opt/innotech/.env on the server.

ENVIRONMENT=production

# PostgreSQL running next to the API (Docker network, no TLS needed inside the host).
DATABASE_URL=postgresql+psycopg://innotech:PASSWORD@db:5432/innotech

# Exact origins of the student portal and admin panel (no wildcards), e.g. the CloudFront URLs until the domain is ready.
CORS_ORIGINS=https://innotech.kiet.edu,https://admin.innotech.kiet.edu

# Signs session tokens. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# OAuth client ID(s) from Google Cloud Console → APIs & Services → Credentials (comma-separated if several).
GOOGLE_CLIENT_IDS=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Always super admins; they add the department admins from the admin panel.
SUPER_ADMIN_EMAILS=someone@kiet.edu

# Registration window (with timezone offset).
REGISTRATION_OPENS=2026-10-03T00:00:00+05:30
REGISTRATION_CLOSES=2026-10-15T23:59:59+05:30

# "log" until SES is ready (emails are only written to the log), then "ses" with a verified sender.
EMAIL_BACKEND=log
SES_REGION=ap-south-1
EMAIL_SENDER=InnoTech'26 <no-reply@innotech.kiet.edu>
PORTAL_URL=https://innotech.kiet.edu

# Department admins' finalist nominations are due by then (default 24 October 2026, 6:00 PM IST).
NOMINATIONS_DEADLINE=2026-10-24T18:00:00+05:30

INVITATIONS_PER_TEAM_PER_DAY=20
