# "mock" uses an in-browser stand-in for the backend where anyone can sign in as anyone: development only.
# Anything else (or unset) talks to the FastAPI backend, and `next build` fails if the values below are missing.
NEXT_PUBLIC_API_MODE=live

# FastAPI base URL, e.g. https://api.innotech.kiet.edu
NEXT_PUBLIC_API_URL=

# Google Identity Services client ID for "Sign in with Google", e.g. 1234-abcd.apps.googleusercontent.com
# Google Cloud Console -> APIs & Services -> Credentials -> Create credentials -> OAuth client ID,
# application type "Web application". Authorised JavaScript origins must include every origin the site
# is served from, e.g. https://innotech.kiet.edu (and http://localhost:3000 for local testing).
# No redirect URIs are needed: sign-in uses a popup. The backend must accept the same client ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Set to "true" only for testing, to allow registration outside 3 to 15 October 2026.
# In live mode the backend decides; this only affects the public pages and the mock.
NEXT_PUBLIC_FORCE_REGISTRATION_OPEN=false

# Local development only: sign in with the local backend's /dev/token instead of Google. Never set in production.
NEXT_PUBLIC_DEV_SIGN_IN=false
