# Copy to deploy/production.env (git-ignored) and fill in. Read by deploy.sh only.

# The AWS CLI profile to deploy with, and the account it must belong to. deploy.sh stops on any other account.
AWS_PROFILE=innotech
AWS_ACCOUNT_ID=000000000000
AWS_REGION=ap-south-1

INSTANCE_TYPE=t4g.medium
# Optional: an email that gets server-down alerts (confirm the subscription email AWS sends).
ALERT_EMAIL=

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
GOOGLE_CLIENT_IDS=
# Organisers who are always super admins (comma-separated); they add department admins in the panel.
SUPER_ADMIN_EMAILS=

# The planned dates. After the first change on the admin panel's Schedule page, the database wins and these are only
# the defaults ("Use the planned dates"), so they never need a redeploy to change.
REGISTRATION_OPENS=2026-10-03T00:00:00+05:30
REGISTRATION_CLOSES=2026-10-15T23:59:59+05:30
# Other colleges, schools, startups and COE KIET (technical clubs) may register until this, later than KIET departments. Optional.
REGISTRATION_EXTENDED_CLOSES=
NOMINATIONS_DEADLINE=2026-10-24T18:00:00+05:30

# "log" until SES production access and the domain are ready, then "ses".
EMAIL_BACKEND=log
EMAIL_SENDER="InnoTech'26 <no-reply@innotech.kiet.edu>"

# ---- KIET subdomain. Uncomment once KIET's DNS records resolve (deploy.sh checks), then: ./deploy.sh api && ./deploy.sh sites
# PORTAL_ORIGIN=https://innotech.kiet.edu
# ADMIN_ORIGIN=https://admin.innotech.kiet.edu
# PORTAL_EXTRA_HOSTS=innotech.kiet.edu
# ADMIN_EXTRA_HOSTS=admin.innotech.kiet.edu
# API_EXTRA_HOSTS=api.innotech.kiet.edu
# API_URL=https://api.innotech.kiet.edu
